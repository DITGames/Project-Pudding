.anim-seq-entry-row {
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.15);
}

.anim-seq-entry-row--selected {
    background-color: rgba(62, 125, 231, 0.35);
}

.anim-seq-track-content {
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.15);
    background-color: rgba(255, 255, 255, 0.02);
}

.anim-seq-channel-foldout {
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.15);
    background-color: rgba(255, 255, 255, 0.04);
}

.anim-seq-channel-foldout:hover {
    background-color: rgba(255, 255, 255, 0.09);
}

.anim-seq-marker {
    background-color: #9e9e9e;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.4);
}

.anim-seq-marker--selected {
    background-color: #ffffff;
    border-color: #ffd54f;
    border-width: 2px;
}

.anim-seq-marker--position {
    background-color: #4caf50;
}

.anim-seq-marker--scale {
    background-color: #2196f3;
}

.anim-seq-marker--rotation {
    background-color: #ff9800;
}

.anim-seq-marker--color {
    background-color: #e91e63;
}

.anim-seq-marker--sprite {
    background-color: #9c27b0;
}

.anim-seq-marker--event {
    background-color: #ffeb3b;
}

.anim-seq-gizmo-mode--active {
    background-color: rgba(62, 125, 231, 0.6);
    color: #ffffff;
}

.anim-seq-mode-edit--active {
    background-color: rgba(220, 60, 60, 0.7);
    color: #ffffff;
}

.anim-seq-track-mute--active {
    background-color: rgba(220, 60, 60, 0.7);
    color: #ffffff;
}

.anim-seq-node--playing #title {
    background-color: rgba(76, 217, 100, 0.9);
}

.anim-seq-node--playing #node-border {
    border-color: rgba(76, 217, 100, 0.9);
    border-width: 2px;
}

.anim-seq-track-solo--active {
    background-color: rgba(255, 193, 7, 0.8);
    color: #1a1a1a;
}
